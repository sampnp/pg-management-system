# Copy this file to .env and change the values. Never commit .env.

# development or production. production (the default when unset) refuses placeholder JWT secrets.
APP_ENV=development

HTTP_PORT=8080

DATABASE_HOST=localhost
# 5433 avoids clashing with a locally installed PostgreSQL on 5432
DATABASE_PORT=5433
DATABASE_NAME=pg_manager
DATABASE_USER=pgmanager
DATABASE_PASSWORD=change_me

# Redis caches the dashboard. Optional at runtime: if Redis is down the dashboard is read from PostgreSQL.
REDIS_HOST=localhost
REDIS_PORT=6379
# How long the cached dashboard is kept (it is also cleared whenever the counted data changes)
DASHBOARD_CACHE_TTL_SECONDS=60

# JWT signing key (HS256). Required, at least 32 characters. In production use a long random value,
# for example: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION_SECONDS=3600

# Public sign-up (POST /api/auth/register) creates MANAGER accounts. Keep it false outside local testing:
# an ADMIN creates staff accounts with POST /api/admin/users instead.
ALLOW_PUBLIC_REGISTRATION=false

# Optional: creates the first ADMIN at startup if there is no ADMIN yet. Remove after the first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
