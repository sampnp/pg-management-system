# Copy this file to .env and change the values. Never commit .env.

HTTP_PORT=8080

DATABASE_HOST=localhost
# 5433 avoids clashing with a locally installed PostgreSQL on 5432
DATABASE_PORT=5433
DATABASE_NAME=pg_manager
DATABASE_USER=pgmanager
DATABASE_PASSWORD=change_me

# Redis caches the dashboard. Optional at runtime: if Redis is down the dashboard is read from PostgreSQL.
REDIS_HOST=localhost
REDIS_PORT=6379
# How long the cached dashboard is kept (it is also cleared whenever the counted data changes)
DASHBOARD_CACHE_TTL_SECONDS=60

# JWT signing key (HS256). Required. Use a long random string, at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_SECONDS=3600
