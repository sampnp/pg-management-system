# Copy this file to .env and change the values. Never commit .env.

HTTP_PORT=8080

DATABASE_HOST=localhost
# 5433 avoids clashing with a locally installed PostgreSQL on 5432
DATABASE_PORT=5433
DATABASE_NAME=pg_manager
DATABASE_USER=pgmanager
DATABASE_PASSWORD=change_me

# Used from Phase 8 (dashboard cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing key (HS256). Required. Use a long random string, at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_SECONDS=3600
